/target
Cargo.lock.bak
*.gguf
!tests/fixtures/*.gguf
!crates/*/tests/fixtures/*.gguf
.DS_Store
__pycache__/
*.pyc
/vast-receipts/
ferrox-journal.log*
/.scratch-logitcheck/
/.scratch/

# Local-only git hooks that scrub machine usernames (never push these).
.githooks/

# Local tooling not distributed with the repository.
/.local-scripts/

# Local agent configuration and installed skills.
/.agents/skills/
/.claude/

# Transient benchmark logs (often embed absolute home paths).
benchmarks/receipts/_tmp_*.log
benchmarks/receipts/_suite_*.log
models/
data/
.env

# Ferrox Studio frontend (source in ui/, standalone app).
# `npm run build` output is NOT committed: the server no longer embeds
# the UI, so nothing here ships inside a Rust crate.
/ui/node_modules/
/ui/dist/
/ui/.vite/
/ui/node_modules/.vite/
/ui/*.tsbuildinfo

# Scratch commit-message files. One was committed by accident in
# 175d20d; agents write these and they are never part of the tree.
.git-msg
.git-msg.*
